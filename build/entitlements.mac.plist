<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Chromium needs both of these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Outbound HTTPS to the Redstone API. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Folders and attachments come from a native picker; screen capture is
       user-triggered (TCC still prompts, these only keep the sandboxed build
       from being denied outright). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Redstone's voice input records through the page. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
